diff --git a/src/layout/monitor.rs b/src/layout/monitor.rs
index 53c0606..0996e58 100644
--- a/src/layout/monitor.rs
+++ b/src/layout/monitor.rs
@@ -1565,12 +1565,12 @@ impl<W: LayoutElement> Monitor<W> {
         if self.overview_progress.is_some() {
             let zoom = self.overview_zoom();
             let pos_within_workspace = (pos_within_output - geo.loc).downscale(zoom);
-            let (win, hit) = ws.window_under(pos_within_workspace)?;
+            let (win, hit) = ws.window_under(pos_within_workspace, true)?;
             // During the overview animation, we cannot do input hits because we cannot really
             // represent scaled windows properly.
             Some((win, hit.to_activate()))
         } else {
-            let (win, hit) = ws.window_under(pos_within_output - geo.loc)?;
+            let (win, hit) = ws.window_under(pos_within_output - geo.loc, false)?;
             Some((win, hit.offset_win_pos(geo.loc)))
         }
     }
diff --git a/src/layout/scrolling.rs b/src/layout/scrolling.rs
index 007bcaf..cbc41a8 100644
--- a/src/layout/scrolling.rs
+++ b/src/layout/scrolling.rs
@@ -2964,7 +2964,11 @@ impl<W: LayoutElement> ScrollingSpace<W> {
         }
     }
 
-    pub fn window_under(&self, pos: Point<f64, Logical>) -> Option<(&W, HitType)> {
+    pub fn window_under(
+        &self,
+        pos: Point<f64, Logical>,
+        is_overview: bool,
+    ) -> Option<(&W, HitType)> {
         // This matches self.tiles_with_render_positions().
         let scale = self.scale;
         let view_off = Point::from((-self.view_pos(), 0.));
@@ -3000,6 +3004,10 @@ impl<W: LayoutElement> ScrollingSpace<W> {
                 // Round to physical pixels.
                 let tile_pos = tile_pos.to_physical_precise_round(scale).to_logical(scale);
 
+                if !is_overview && tile.is_offscreen_input_ignored(tile_pos) {
+                    continue;
+                }
+
                 if let Some(rv) = HitType::hit_tile(tile, tile_pos, pos) {
                     return Some(rv);
                 }
diff --git a/src/layout/tile.rs b/src/layout/tile.rs
index 86c7eba..1ec3f52 100644
--- a/src/layout/tile.rs
+++ b/src/layout/tile.rs
@@ -897,6 +897,16 @@ impl<W: LayoutElement> Tile<W> {
         }
     }
 
+    pub fn is_offscreen_input_ignored(&self, tile_pos: Point<f64, Logical>) -> bool {
+        if !self.options.layout.ignore_offscreen_windows_input {
+            return false;
+        }
+
+        let view = Rectangle::from_size(self.view_size);
+        let tile = Rectangle::new(tile_pos + self.bob_offset(), self.animated_tile_size());
+        !view.overlaps(tile)
+    }
+
     pub fn request_tile_size(
         &mut self,
         mut size: Size<f64, Logical>,
diff --git a/src/layout/workspace.rs b/src/layout/workspace.rs
index 49548a8..dbf5ba1 100644
--- a/src/layout/workspace.rs
+++ b/src/layout/workspace.rs
@@ -1753,19 +1753,26 @@ impl<W: LayoutElement> Workspace<W> {
         self.scrolling.start_open_animation(id) || self.floating.start_open_animation(id)
     }
 
-    pub fn window_under(&self, pos: Point<f64, Logical>) -> Option<(&W, HitType)> {
+    pub fn window_under(
+        &self,
+        pos: Point<f64, Logical>,
+        is_overview: bool,
+    ) -> Option<(&W, HitType)> {
         // This logic is consistent with tiles_with_render_positions().
         if self.is_floating_visible() {
             if let Some(rv) = self
                 .floating
                 .tiles_with_render_positions()
+                .filter(|(tile, tile_pos)| {
+                    is_overview || !tile.is_offscreen_input_ignored(*tile_pos)
+                })
                 .find_map(|(tile, tile_pos)| HitType::hit_tile(tile, tile_pos, pos))
             {
                 return Some(rv);
             }
         }
 
-        self.scrolling.window_under(pos)
+        self.scrolling.window_under(pos, is_overview)
     }
 
     pub fn resize_edges_under(&self, pos: Point<f64, Logical>) -> Option<ResizeEdge> {
@@ -1773,7 +1780,7 @@ impl<W: LayoutElement> Workspace<W> {
             .find_map(|(tile, tile_pos, visible)| {
                 // This logic should be consistent with window_under() in when it returns Some vs.
                 // None.
-                if !visible {
+                if !visible || tile.is_offscreen_input_ignored(tile_pos) {
                     return None;
                 }
 
